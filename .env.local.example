# Supabase の接続情報
#
# このファイルをコピーして .env.local を作り、値を入れる。
#   Copy-Item .env.local.example .env.local
#
# 値は Supabase の画面 → Settings → API から取得する。
# .env.local は .gitignore 済みなので GitHub には上がらない。
# 本番（Vercel）は Settings → Environment Variables に同じものを設定する。

# プロジェクトのURL。例: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon key（公開前提のキー。ブラウザに埋め込まれる）
# ★ データを守るのは RLS であってこのキーの秘匿ではない。RLS を切らないこと。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key（全権限を持つ。★絶対に公開しない）
# ・NEXT_PUBLIC_ を付けない（付けるとブラウザに露出する）
# ・サーバ側の処理でだけ使う。今はまだ使わないので空でよい
SUPABASE_SERVICE_ROLE_KEY=
